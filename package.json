{
  "name": "helios",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "app": "node scripts/run-app.mjs",
    "app:build": "node scripts/run-app.mjs --build-only",
    "start": "npm run app",
    "dev": "node scripts/stop-app.mjs && tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "bundle": "tauri build",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "vitest run && cargo test --workspace",
    "test:ui": "vitest run",
    "stop": "node scripts/stop-app.mjs",
    "debug:hang": "node scripts/debug-hang.mjs",
    "debug:log": "node scripts/debug-log.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@types/gsap": "^1.20.2",
    "clipper2-ts": "^2.0.1-18",
    "dompurify": "^3.2.0",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "lucide": "^1.48.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
