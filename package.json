{
  "name": "helios",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app": "node scripts/run-app.mjs",
    "app:build": "node scripts/run-app.mjs --build-only",
    "start": "npm run app",
    "dev": "node scripts/stop-app.mjs && tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "bundle": "tauri build",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "vitest run && cargo test --workspace",
    "test:ui": "vitest run",
    "stop": "node scripts/stop-app.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "dompurify": "^3.2.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
